# Variables de entorno para Azure Database for PostgreSQL
# Copia este archivo a .env y reemplaza los valores de ejemplo.
# Nunca compartas credenciales reales ni los valores reales de tu entorno local.

POSTGRES_HOST=your-postgres-host.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=replace-with-your-secure-local-password

# Variables de entorno para Azure AI Foundry / Function Calling
AZURE_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com/api/projects/your-project-name
AZURE_AGENT_NAME=supply-chain-planner
AZURE_MODEL_NAME=gpt-4.1-mini
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=replace-with-your-azure-client-secret

# Configuración del servidor MCP local y del panel web
MCP_API_KEY=replace-with-a-local-random-token
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
PORT=8000
LOG_LEVEL=INFO
